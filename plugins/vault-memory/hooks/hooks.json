{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          { "type": "command", "command": "python -I -S \"${CLAUDE_PLUGIN_ROOT}/skills/vault/scripts/vault.py\" session", "timeout": 10 }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          { "type": "command", "command": "python -I -S \"${CLAUDE_PLUGIN_ROOT}/skills/vault/scripts/vault.py\" subagent", "timeout": 5 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "python -I -S \"${CLAUDE_PLUGIN_ROOT}/skills/vault/scripts/vault.py\" hook", "timeout": 3 }
        ]
      }
    ]
  }
}
